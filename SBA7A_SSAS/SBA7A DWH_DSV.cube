  <MdxScripts>
    <MdxScript dwd:design-time-name="0c53d936-1da4-4393-92d5-ff13fb882d5f">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Average Approval per Record]
 AS IIF(
    IsEmpty([Measures].[Record Count])
    OR [Measures].[Record Count] = 0,
    NULL,
    [Measures].[Gross Approval]
    / [Measures].[Record Count]
),
FORMAT_STRING = "#,##0.00;-#,##0.00",
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Loan'  ;
CREATE MEMBER CURRENTCUBE.[Measures].[State Approval Share]
 AS IIF(
    IsEmpty(
        (
            [Measures].[Gross Approval],
            [Dim Project Geography].[Project Geography].DefaultMember
        )
    )
    OR
    (
        [Measures].[Gross Approval],
        [Dim Project Geography].[Project Geography].DefaultMember
    ) = 0,
    NULL,
    [Measures].[Gross Approval]
    /
    (
        [Measures].[Gross Approval],
        [Dim Project Geography].[Project Geography].DefaultMember
    )
),
FORMAT_STRING = "#,##0.00%;-#,##0.00%",
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Loan'  ;
CREATE MEMBER CURRENTCUBE.[Measures].[Prior FY Gross Approval]
 AS IIF(
    [Dim Date].[Fiscal Date].CurrentMember.Level.Name
        &lt;&gt; "Fiscal Year",
    NULL,
    (
        [Measures].[Gross Approval],
        [Dim Date].[Fiscal Date].CurrentMember.PrevMember
    )
),
FORMAT_STRING = "#,##0.00;-#,##0.00",
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Loan'  ;
CREATE MEMBER CURRENTCUBE.[Measures].[YoY Gross Approval Growth]
 AS IIF(
    IsEmpty([Measures].[Prior FY Gross Approval])
    OR [Measures].[Prior FY Gross Approval] = 0,
    NULL,
    (
        [Measures].[Gross Approval]
        - [Measures].[Prior FY Gross Approval]
    )
    / [Measures].[Prior FY Gross Approval]
),
FORMAT_STRING = "#,##0.00%;-#,##0.00%",
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Loan'  ;
CREATE MEMBER CURRENTCUBE.[Measures].[SBA Guarantee Ratio]
 AS IIF(
    IsEmpty([Measures].[Gross Approval])
    OR [Measures].[Gross Approval] = 0,
    NULL,
    [Measures].[SBA Guaranteed Approval]
    / [Measures].[Gross Approval]
),
FORMAT_STRING = "#,##0.00%;-#,##0.00%",
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Loan'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>