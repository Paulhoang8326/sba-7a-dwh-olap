                <property dataType="System.String" description="Specifies a SQL statement that uses parameters to generate the lookup table." expressionType="Notify" name="SqlCommandParam" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT * FROM (SELECT LoanProfileKey, CAST(COALESCE(NULLIF(LTRIM(RTRIM([ProcessingMethod])), ''), '(Missing)') AS NVARCHAR(150)) AS [LK_ProcessingMethod], CAST(COALESCE(NULLIF(LTRIM(RTRIM([FixedOrVariableInterestInd])), ''), '(Missing)') AS NVARCHAR(50)) AS [LK_FixedOrVariableInterestInd], CAST(COALESCE(NULLIF(LTRIM(RTRIM([RevolverStatus])), ''), '(Missing)') AS NVARCHAR(50)) AS [LK_RevolverStatus], CAST(COALESCE(NULLIF(LTRIM(RTRIM([CollateralInd])), ''), '(Missing)') AS NVARCHAR(50)) AS [LK_CollateralInd] FROM dbo.Dim_LoanProfile) AS refTable WHERE [refTable].[LK_ProcessingMethod] = ? AND [refTable].[LK_FixedOrVariableInterestInd] = ? AND [refTable].[LK_RevolverStatus] = ? AND [refTable].[LK_CollateralInd] = ?</property>
