            <component refId="Package\Fact_Loan\LOOKUP_Business" componentClassID="Microsoft.Lookup" contactInfo="Lookup;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;6" description="Joins additional columns to the data flow by looking up values in a table. For example, join to the 'employee id' column the employees table to get 'hire date' and 'employee name'. We recommend this transformation when the lookup table can fit into memory." name="LOOKUP_Business" usesDispositions="true" version="6">
              <properties>
                <property dataType="System.String" description="Specifies the SQL statement that generates the lookup table." expressionType="Notify" name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    BusinessKey,
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(BusinessTypeRaw)), ''),
            '(Missing)'
        ) AS VARCHAR(150)
    ) AS LK_BusinessType,
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(BusinessAgeRaw)), ''),
            '(Missing)'
        ) AS VARCHAR(150)
    ) AS LK_BusinessAge
FROM dbo.Dim_Business</property>
                <property dataType="System.String" description="Specifies a SQL statement that uses parameters to generate the lookup table." expressionType="Notify" name="SqlCommandParam" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (SELECT
    BusinessKey,
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(BusinessTypeRaw)), ''),
            '(Missing)'
        ) AS VARCHAR(150)
    ) AS LK_BusinessType,
    CAST(
        COALESCE(
            NULLIF(LTRIM(RTRIM(BusinessAgeRaw)), ''),
            '(Missing)'
        ) AS VARCHAR(150)
    ) AS LK_BusinessAge
FROM dbo.Dim_Business) [refTable]
where [refTable].[LK_BusinessType] = ? and [refTable].[LK_BusinessAge] = ?</property>
