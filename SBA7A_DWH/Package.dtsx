            <component refId="Package\Dim_ProjectGeography\LOOKUP_Geography" componentClassID="Microsoft.Lookup" contactInfo="Lookup;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;6" description="Joins additional columns to the data flow by looking up values in a table. For example, join to the 'employee id' column the employees table to get 'hire date' and 'employee name'. We recommend this transformation when the lookup table can fit into memory." name="LOOKUP_Geography" usesDispositions="true" version="6">
              <properties>
                <property dataType="System.String" description="Specifies the SQL statement that generates the lookup table." expressionType="Notify" name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT GeographyKey, CAST(COALESCE(NULLIF(LTRIM(RTRIM([ProjectState])), ''), '(Missing)') AS NVARCHAR(10)) AS [LK_ProjectState], CAST(COALESCE(NULLIF(LTRIM(RTRIM([ProjectCounty])), ''), '(Missing)') AS NVARCHAR(150)) AS [LK_ProjectCounty], CAST(COALESCE(NULLIF(LTRIM(RTRIM([CongressionalDistrict])), ''), '(Missing)') AS NVARCHAR(50)) AS [LK_CongressionalDistrict], CAST(COALESCE(NULLIF(LTRIM(RTRIM([SBADistrictOffice])), ''), '(Missing)') AS NVARCHAR(200)) AS [LK_SBADistrictOffice] FROM dbo.Dim_ProjectGeography</property>
